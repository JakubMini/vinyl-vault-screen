{
  "name": "vinyl-vault-screen-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "The public door the vinyl vault screen uses to reach the vault.",
  "type": "module",
  "scripts": {
    "postinstall": "wrangler types",
    "dev": "wrangler dev --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run types && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
